# Memgraph Database Configuration
MEMGRAPH_HOST=memgraph
MEMGRAPH_PORT=7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Dynamic Model Selection & Resilience Strategy
# Supported providers: ollama, groq, openai, openrouter, custom
PRIMARY_LLM_PROVIDER=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
PRIMARY_API_KEY=ollama
FALLBACK_API_KEY=

# Task-Based Model Routing Tiers
MODEL_SCANNING=llama3.2:latest
MODEL_ELICITATION=llama3.1:latest
MODEL_PLANNING=llama3.1:latest
MODEL_CYPHER=llama3.1:latest
MODEL_CODING=llama3.1:latest

# Fallback Hierarchy (comma-separated list of models to try on failure)
MODEL_FALLBACK_LIST=llama3.1:latest,llama3.2:latest

# Exponential Backoff and Retry Configuration
LLM_MAX_RETRIES=4
LLM_BACKOFF_FACTOR=2.0
LLM_TIMEOUT_SECONDS=60.0
